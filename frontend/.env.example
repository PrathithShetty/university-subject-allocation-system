# Base URL of the deployed backend API, including the /api suffix.
# Leave unset for local development - axios.js falls back to
# http://127.0.0.1:8000/api automatically.
#
# On Vercel, set this as a Project Environment Variable (Settings ->
# Environment Variables), not by committing a real .env file.
VITE_API_URL=https://your-backend.onrender.com/api
