# Local development values. Copy this file to `.env` and adjust as needed.
# On Render, these are set as environment variables in the dashboard
# instead (see render.yaml) - DATABASE_URL there overrides the two
# DATABASE_* fields below entirely.

SECRET_KEY=django-insecure-change-this-to-something-random
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
